<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Brusca.Infrastructure</AssemblyName>
    <RootNamespace>Brusca.Infrastructure</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <PackageId>Brusca.Infrastructure</PackageId>
    <Authors>Brusca</Authors>
    <Description>Infrastructure implementations (Dapper, Claude, Serilog, Audit.NET) for the Brusca file organizer.</Description>
    <RepositoryUrl>https://github.com/your-org/Brusca.Infrastructure</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core domain — consumed as a NuGet package from the shared local feed during development -->
    <PackageReference Include="Brusca.Core" Version="1.0.999-pii" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data access -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <!-- Audit logging - concrete provider -->
    <PackageReference Include="Audit.NET.SqlServer" Version="27.*" />
    <!-- Structured error logging -->
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.*" />
    <PackageReference Include="Serilog.Formatting.Elasticsearch" Version="10.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.*" />
    <!-- Claude SDK -->
    <PackageReference Include="Anthropic.SDK" Version="3.*" />
    <!-- Common file type reading -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <!-- Encryption -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.*" />
    <!-- Result pattern -->
    <PackageReference Include="FluentResults" Version="3.*" />
    <PackageReference Include="Ardalis.GuardClauses" Version="4.*" />
  </ItemGroup>

</Project>
